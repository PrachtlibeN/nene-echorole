ECHOROLE_DB_URL=sqlite:///./data/echorole.db
CORS_ORIGINS=["http://localhost:5173"]
LLM_PROVIDER=openai_compatible
OLLAMA_BASE_URL=http://localhost:11434
# Provisional local candidate; see docs/architecture/LLM_BENCHMARK.md.
OLLAMA_MODEL=qwen2.5:3b
# Optional profile overrides:
# OLLAMA_MODEL_ROLEPLAY=
# OLLAMA_MODEL_EVALUATION=
# For Groq, set LLM_PROVIDER=openai_compatible and OPENAI_BASE_URL=https://api.groq.com/openai/v1.
# For Google AI Studio, use OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/.
# Set OPENAI_MODEL and OPENAI_API_KEY in your local .env; never commit the API key.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile
OLLAMA_NUM_CTX=2048
LLM_TIMEOUT_S=180
ROLEPLAY_TEMPERATURE=0.8
ROLEPLAY_MAX_TOKENS=160
EVALUATION_TEMPERATURE=0.2
EVALUATION_MAX_TOKENS=1200
ROLEPLAY_HISTORY_TURNS=12
WHISPER_MODEL=tiny.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_SECONDS=120
MAX_AUDIO_MB=10
SESSION_IDLE_TIMEOUT_MINUTES=60
